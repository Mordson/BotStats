# Bot token from the Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=wstaw_tutaj_token_bota

# Discord guild ID to track (right-click the server -> Copy ID)
GUILD_ID=wstaw_tutaj_id_serwera

# PostgreSQL password — set a strong password, especially on a production server
POSTGRES_PASSWORD=zmien_na_silne_haslo

# PostgreSQL connection string
# NOTE: in Docker Compose the hostname is the service name ("postgres"), NOT "localhost"
DATABASE_URL=postgresql+asyncpg://postgres:zmien_na_silne_haslo@postgres:5432/discord_activity

# Allowed CORS origins (API).
# In production, provide a specific IP address or server domain, e.g.: http://1.2.3.4:8501
# "*" = any domain — local development only!
CORS_ORIGINS=*

# Discord role IDs (comma-separated) whose holders should appear
# in the dashboard's game sections (game leaderboard, per-user game stats).
# To copy a role ID: enable developer mode (Discord Settings -> Advanced
# -> Developer Mode), then right-click the role on the server -> Copy Role ID.
# Empty = no filtering (everyone is visible).
VISIBLE_ROLE_IDS=
