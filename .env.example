# Token bota z Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=wstaw_tutaj_token_bota

# ID serwera Discord do śledzenia (prawy klik na serwer -> Kopiuj ID)
GUILD_ID=wstaw_tutaj_id_serwera

# Hasło do PostgreSQL — ustaw silne hasło, szczególnie na serwerze produkcyjnym
POSTGRES_PASSWORD=zmien_na_silne_haslo

# Connection string do PostgreSQL
# UWAGA: w Docker Compose hostname to nazwa serwisu ("postgres"), NIE "localhost"
DATABASE_URL=postgresql+asyncpg://postgres:zmien_na_silne_haslo@postgres:5432/discord_activity

# Dozwolone originy dla CORS (API).
# Na produkcji podaj konkretny adres IP lub domenę serwera, np.: http://1.2.3.4:8501
# "*" = dowolna domena — tylko do developmentu lokalnego!
CORS_ORIGINS=*
